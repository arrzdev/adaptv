{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["bin/**/*.mjs", "packages/create-adaptv/*.mjs"],
  "exclude": ["bin/**/*.test.mjs", "packages/**/*.test.mjs"]
}
