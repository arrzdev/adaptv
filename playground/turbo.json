{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@repo/frontend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "biome": {},
    "dev:ios": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "dev:android": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "dev:all": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "dev:web": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "preview:web": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "preview:ios": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "preview:android": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "preview:all": {
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
