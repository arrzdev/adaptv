{
  "name": "chopchop",
  "private": true,
  "overrides": {
    "esbuild": "0.27.3"
  },
  "scripts": {
    "dev:web": "turbo run dev:web --ui=tui",
    "dev:ios": "turbo run dev:ios --ui=tui",
    "dev:android": "turbo run dev:android --ui=tui",
    "dev:all": "turbo run dev:all --ui=tui",
    "preview:web": "turbo run preview:web --ui=tui",
    "preview:ios": "turbo run preview:ios --ui=tui",
    "preview:android": "turbo run preview:android --ui=tui",
    "preview:all": "turbo run preview:all --ui=tui",
    "build:ios": "pnpm --filter @repo/frontend run build:ios",
    "build:android": "pnpm --filter @repo/frontend run build:android",
    "build:all": "pnpm --filter @repo/frontend run build:all",
    "dev:clean": "rm -rf node_modules && pnpm install && turbo run dev:web --ui=tui",
    "adaptv": "pnpm --dir apps/frontend exec adaptv",
    "start": "turbo run start --ui=tui",
    "logs": "tsx packages/dev/src/log-sink.ts",
    "build": "turbo run build",
    "biome:fix": "biome check . --write --unsafe",
    "biome:check": "biome check .",
    "lint": "pnpm run biome:check",
    "typecheck": "pnpm exec tsc --build tsconfig.json && pnpm exec tsc --noEmit -p apps/frontend/tsconfig.json",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:stress": "playwright test --config playwright.stress.config.ts",
    "test:e2e:plain": "playwright test --config playwright.plain.config.ts",
    "test:e2e:sw": "playwright test --config playwright.sw.config.ts",
    "test:e2e:sw:spa": "playwright test --config playwright.sw-spa.config.ts",
    "test:e2e:sw:prompt": "playwright test --config playwright.sw-prompt.config.ts",
    "test:e2e:sw:subpath": "playwright test --config playwright.sw-subpath.config.ts",
    "test:e2e:sw:node": "playwright test --config playwright.sw-node.config.ts",
    "test:e2e:sw:all": "pnpm run test:e2e:sw && pnpm run test:e2e:sw:spa && pnpm run test:e2e:sw:prompt && pnpm run test:e2e:sw:subpath && pnpm run test:e2e:sw:node"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "1.61.1",
    "@tanstack/intent": "0.0.41",
    "husky": "9.1.7",
    "tsx": "4.19.3",
    "turbo": "2.10.7",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@biomejs/cli-linux-x64": "2.3.11",
    "@rollup/rollup-linux-x64-gnu": "4.60.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.4",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4"
}
