# Copy to .env in this folder. .env is gitignored. CI also builds from these
# placeholder values (it does NOT run check:env); deploy uses the real GH env.
VITE_BACKEND_URL=http://localhost:41810
# LAN / another device: wrangler dev binds 0.0.0.0 by default; use your machine IP in this url and in BETTER_AUTH_*
