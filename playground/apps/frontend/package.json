{
  "name": "@repo/frontend",
  "private": true,
  "type": "module",
  "imports": {
    "@/ports": "./ports.ts",
    "@/*": "./src/*"
  },
  "scripts": {
    "dev:web": "tsx scripts/dev.ts",
    "dev:ios": "tsx scripts/dev.ts ios",
    "dev:android": "tsx scripts/dev.ts android",
    "dev:all": "tsx scripts/dev.ts all",
    "preview:web": "tsx scripts/preview.ts",
    "preview:ios": "tsx scripts/preview.ts ios",
    "preview:android": "tsx scripts/preview.ts android",
    "preview:all": "tsx scripts/preview.ts all",
    "ota:lab": "tsx scripts/ota-lab.ts",
    "build": "vite build",
    "build:plain": "vite build --config vite.plain.config.ts",
    "build:ios": "adaptv build ios",
    "build:android": "adaptv build android",
    "build:all": "adaptv build all",
    "biome:fix": "biome check --write .",
    "biome:check": "biome check .",
    "start": "vite preview",
    "test": "tsx --test scripts/ota-lab.test.ts"
  },
  "dependencies": {
    "adaptv": "link:../../..",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.2.8",
    "@repo/dev": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/synq": "workspace:*",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-query": "5.90.16",
    "canvas-confetti": "1.9.4",
    "clsx": "2.1.1",
    "dexie": "4.4.2",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "0.544.0",
    "motion": "link:../../../node_modules/motion",
    "react": "link:../../../node_modules/react",
    "react-dom": "link:../../../node_modules/react-dom",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.2.4",
    "vite": "link:../../../node_modules/vite",
    "workbox-window": "7.4.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.19.3",
    "wrangler": "4.78.0"
  }
}
