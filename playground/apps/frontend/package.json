{
  "name": "@repo/frontend",
  "private": true,
  "type": "module",
  "imports": {
    "@/env/*": "./env/*",
    "@/ports": "./ports.ts",
    "@/*": "./src/*"
  },
  "scripts": {
    "check:env": "tsx env/check-env.ts",
    "dev:web": "tsx scripts/dev.ts",
    "dev:ios": "tsx scripts/dev.ts ios",
    "dev:android": "tsx scripts/dev.ts android",
    "dev:all": "tsx scripts/dev.ts all",
    "preview:web": "tsx scripts/preview.ts",
    "preview:ios": "tsx scripts/preview.ts ios",
    "preview:android": "tsx scripts/preview.ts android",
    "preview:all": "tsx scripts/preview.ts all",
    "build": "vite build",
    "build:ios": "tsx env/check-env.ts && adaptv build ios",
    "build:android": "tsx env/check-env.ts && adaptv build android",
    "build:all": "tsx env/check-env.ts && adaptv build all",
    "biome:fix": "biome check --write .",
    "biome:check": "biome check .",
    "start": "vite preview",
    "test": "echo \"No tests configured\""
  },
  "dependencies": {
    "@arrzdev/adaptv": "link:../../..",
    "@capacitor/device": "8.0.3",
    "@cloudflare/vite-plugin": "1.30.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@repo/dev": "workspace:*",
    "@repo/env-validation": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/synq": "workspace:*",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-query": "5.90.16",
    "@tanstack/react-router": "1.168.8",
    "@tanstack/react-start": "1.167.13",
    "better-auth": "1.6.22",
    "canvas-confetti": "1.9.4",
    "dexie": "4.4.2",
    "dexie-react-hooks": "4.4.0",
    "hono": "4.11.8",
    "lucide-react": "0.544.0",
    "motion": "12.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.2.4",
    "tailwindcss-safe-area": "1.3.0",
    "vite": "link:../../../node_modules/vite",
    "workbox-window": "7.4.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260317.1",
    "@repo/backend": "workspace:*",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.19.3",
    "wrangler": "4.78.0"
  }
}
