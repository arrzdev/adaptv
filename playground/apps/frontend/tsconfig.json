{
  "extends": "../../tsconfig.base.json",
  "include": [".adaptv/**/*.ts", "**/*.ts", "**/*.tsx", "src/**/*.css"],
  // Every workspace package the app imports is referenced here, so TypeScript
  // resolves it to its emitted .d.ts instead of pulling the package's raw source
  // into this program. `@repo/dev` used to arrive transitively (through the
  // backend project, which referenced it); with the backend gone the chain broke
  // and `run-dev.ts` was compiled here, where its own `#dev/*` paths don't exist.
  "references": [
    {
      "path": "../../packages/dev/tsconfig.build.json"
    },
    {
      "path": "../../packages/shared/tsconfig.build.json"
    },
    {
      "path": "../../packages/synq/tsconfig.build.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#adaptv-route-tree": ["./.adaptv/routeTree.gen.ts"],
      // ⚠︎ TEMPORARY, and a bug report in the form of a path mapping.
      // `Text` (src/components/text.tsx) is NOT re-exported from
      // `src/interface/components.index.ts`, and adaptv's package `exports`
      // map has no wildcard — so `@arrzdev/adaptv/components` cannot reach it
      // and no consumer can import it at all. The Testing → Text page needs to
      // render the real component, so it reaches past the export map through
      // this alias. DELETE this mapping the moment the barrel exports Text.
      "@/ports": ["./ports.ts"],
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
