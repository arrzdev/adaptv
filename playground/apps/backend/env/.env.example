# Backend env — the documented contract. Copy this to `env/.env` and fill in real
# values. `check:env` validates `env/.env`; `wrangler dev` loads it at runtime via
# `--env-file env/.env`, and deploy uploads the same file as Worker secrets.

# 32+ char random secret (openssl rand -hex 32). Signs sessions/tokens.
BETTER_AUTH_SECRET=your-32-char-min-random-secret
# Full public URL of THIS api (better-auth baseURL + oauth callback origin).
BETTER_AUTH_URL=http://localhost:41810
# The web app origin — CORS allowlist + oauth post-login redirect target.
FRONTEND_URL=http://localhost:41710

# OAuth providers are optional. A provider only appears in the login UI when
# BOTH its id and secret are set. Add a provider = add its two vars + a block
# in src/services/auth.service.ts.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
