{
  "name": "@arrzdev/adaptv",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform React framework — one codebase ships as web, installable PWA, and native iOS/Android (Capacitor), correct-by-construction on every target.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arrzdev/adaptv.git"
  },
  "bin": {
    "adaptv": "./bin/adaptv.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "adaptv": "node scripts/playground.mjs adaptv",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "build": "tsdown",
    "build:all": "node scripts/playground.mjs build:all",
    "build:android": "node scripts/playground.mjs build:android",
    "build:check": "tsdown && node scripts/verify-dist.mjs",
    "build:ios": "node scripts/playground.mjs build:ios",
    "dev:all": "node scripts/playground.mjs dev:all",
    "dev:android": "node scripts/playground.mjs dev:android",
    "dev:ios": "node scripts/playground.mjs dev:ios",
    "dev:web": "node scripts/playground.mjs dev:web",
    "gate": "pnpm biome:check && pnpm typecheck && pnpm test && node scripts/check-colour.mjs",
    "playground:setup": "node scripts/playground-setup.mjs",
    "preview:all": "node scripts/playground.mjs preview:all",
    "preview:android": "node scripts/playground.mjs preview:android",
    "preview:ios": "node scripts/playground.mjs preview:ios",
    "preview:web": "node scripts/playground.mjs preview:web",
    "smoke:android": "node scripts/native-plugin-smoke.mjs --app playground/apps/frontend",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#adaptv/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "exports": {
    "./package.json": "./package.json",
    "./biome-shared.json": "./biome-shared.json",
    "./shell": "./src/interface/shell.index.ts",
    "./router": "./src/interface/router.index.ts",
    "./route-globals": "./src/interface/route-globals.d.ts",
    "./config": "./src/interface/config.index.ts",
    "./components": "./src/interface/components.index.ts",
    "./hooks": "./src/interface/hooks.index.ts",
    "./capabilities": "./src/interface/capabilities.index.ts",
    "./storage": "./src/interface/storage.index.ts",
    "./ota": "./src/interface/ota.index.ts",
    "./routes": "./src/interface/routes.index.ts",
    "./utils": "./src/interface/utils.index.ts",
    "./sw": "./src/interface/sw.index.ts",
    "./vite": "./src/interface/vite.index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "peerDependencies": {
    "@tanstack/react-router": "1.168.8",
    "clsx": "2.1.1",
    "motion": "12.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.2.4",
    "vite": "8.0.11"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/cli": "8.4.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/geolocation": "8.0.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.2",
    "@tanstack/react-start": "1.167.13",
    "@tanstack/react-virtual": "3.14.6",
    "@tanstack/virtual-file-routes": "1.161.7",
    "@vitejs/plugin-react": "5.2.0",
    "commander": "15.0.0",
    "esbuild": "0.28.0",
    "ink": "6.4.0",
    "sharp": "0.35.3",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "clsx": "2.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "20.10.6",
    "motion": "12.35.0",
    "publint": "0.3.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.2.4",
    "tsdown": "0.22.12",
    "typescript": "5.9.3",
    "vite": "8.0.11",
    "vitest": "4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ],
    "overrides": {
      "@capacitor/core": "8.4.2"
    }
  },
  "files": [
    "src",
    "patches",
    "bin",
    "assets",
    "biome-shared.json",
    "THIRD_PARTY_LICENSES"
  ]
}
