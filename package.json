{
  "name": "@arrzdev/adaptv",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "One React codebase, shipped as desktop web, mobile web, an installable home-screen app, and real iOS and Android apps that don't feel like a website in a box.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arrzdev/adaptv.git"
  },
  "bin": {
    "adaptv": "./bin/adaptv.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "adaptv": "node scripts/playground.mjs adaptv",
    "biome:check": "biome check .",
    "biome:check:playground": "node scripts/playground.mjs biome:check",
    "biome:fix": "biome check --write .",
    "build": "tsdown",
    "build:all": "node scripts/playground.mjs build:all",
    "build:android": "node scripts/playground.mjs build:android",
    "build:check": "tsdown && node scripts/verify-dist.mjs",
    "build:ios": "node scripts/playground.mjs build:ios",
    "dev:all": "node scripts/playground.mjs dev:all",
    "dev:android": "node scripts/playground.mjs dev:android",
    "dev:ios": "node scripts/playground.mjs dev:ios",
    "dev:web": "node scripts/playground.mjs dev:web",
    "gate": "pnpm biome:check && pnpm biome:check:playground && pnpm typecheck && pnpm test && node scripts/check-colour.mjs && pnpm build:check",
    "playground:setup": "node scripts/playground-setup.mjs",
    "preview:all": "node scripts/playground.mjs preview:all",
    "preview:android": "node scripts/playground.mjs preview:android",
    "preview:ios": "node scripts/playground.mjs preview:ios",
    "preview:web": "node scripts/playground.mjs preview:web",
    "smoke:android": "node scripts/native-plugin-smoke.mjs --app playground/apps/frontend",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bin.json",
    "website:dev": "pnpm --dir website dev"
  },
  "imports": {
    "#adaptv/*": "./src/*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./biome-shared.json": "./biome-shared.json",
    "./shell": {
      "types": "./dist/shell.d.mts",
      "default": "./dist/shell.mjs"
    },
    "./router": {
      "types": "./dist/router.d.mts",
      "default": "./dist/router.mjs"
    },
    "./root-route": {
      "types": "./dist/root-route.d.mts",
      "default": "./dist/root-route.mjs"
    },
    "./route-globals": "./dist/interface/route-globals.d.ts",
    "./server-entry": {
      "types": "./dist/server-entry.d.mts",
      "default": "./dist/server-entry.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./components": {
      "types": "./dist/components.d.mts",
      "default": "./dist/components.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.mts",
      "default": "./dist/hooks.mjs"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.mts",
      "default": "./dist/capabilities.mjs"
    },
    "./storage": {
      "types": "./dist/storage.d.mts",
      "default": "./dist/storage.mjs"
    },
    "./ota": {
      "types": "./dist/ota.d.mts",
      "default": "./dist/ota.mjs"
    },
    "./routes": {
      "types": "./dist/routes.d.mts",
      "default": "./dist/routes.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./sw": {
      "types": "./dist/sw.d.mts",
      "default": "./dist/sw.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "peerDependencies": {
    "clsx": "2.1.1",
    "motion": "12.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.2.4",
    "vite": "8.0.11"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.0",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.0",
    "@capacitor/cli": "8.4.3",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.4.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.0.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.3",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/privacy-screen": "2.0.1",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/screen-reader": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.2",
    "@capawesome/capacitor-live-update": "8.3.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/react-virtual": "3.14.6",
    "@tanstack/router-core": "1.171.15",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@vitejs/plugin-react": "5.2.0",
    "commander": "15.0.0",
    "esbuild": "0.28.0",
    "ink": "6.4.0",
    "lightningcss": "1.32.0",
    "nitro": "3.0.260610-beta",
    "postcss": "8.5.19",
    "sharp": "0.35.3",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.3.2",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.2",
    "clsx": "2.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.2",
    "motion": "12.35.0",
    "publint": "0.3.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.2.4",
    "tsdown": "0.22.12",
    "typescript": "5.9.3",
    "vite": "8.0.11",
    "vitest": "4.1.2"
  },
  "files": [
    "dist",
    "patches",
    "bin",
    "assets",
    "biome-shared.json",
    "THIRD_PARTY_LICENSES"
  ]
}
