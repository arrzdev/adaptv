-	server: "virtual:tanstack-start-server-entry",
+	client: "virtual:nativ/client-entry",
+	server: "virtual:nativ/server-entry",
+	//NOT renamed: these are package subpath imports declared in
+	//@tanstack/start-server-core's own package.json "imports" map, so renaming
