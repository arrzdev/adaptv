{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.vscode",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.adaptv",
      "!!**/.output",
      "!!**/.tsbuild",
      "!!**/.turbo",
      "!!**/coverage",
      "!!**/*.tsbuildinfo",
      "!!**/*.css",
      "!!**/*.log",
      "!!**/.DS_Store",
      "!!**/.project-zero",
      "!!**/playground",
      "!!**/website",
      "!!.claude"
    ],
    "ignoreUnknown": true
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "motion/react": {
                "importNames": [
                  "motion",
                  "m",
                  "LazyMotion",
                  "MotionConfig",
                  "AnimatePresence",
                  "LayoutGroup",
                  "animate",
                  "useAnimate",
                  "animateMini",
                  "useAnimateMini",
                  "animateValue",
                  "animateMotionValue",
                  "animateSingleValue",
                  "animateVisualElement",
                  "createScopedAnimate"
                ],
                "message": "No motion components, providers or animate(): components wrap app content in motion's context, and animate() ships motion's visual element and sequence code. Animate an element with #adaptv/hooks/use-animated-style, or with CSS (docs/decisions/animation.md A7)."
              },
              "motion/react-client": "No motion components in adaptv; animate imperatively with #adaptv/hooks/use-animated-style (docs/decisions/animation.md A7).",
              "motion/react-m": "No motion components in adaptv; animate imperatively with #adaptv/hooks/use-animated-style (docs/decisions/animation.md A7).",
              "framer-motion": "Import motion's engine from motion/react, and animate imperatively (docs/decisions/animation.md A7)."
            },
            "patterns": [
              {
                "group": ["./*", "../*"],
                "message": "Use the #adaptv/* self-alias, not ./ or ../."
              }
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 75
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["*.css", "**/*.html"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/config/**", "src/vite/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/interface/*.index.ts",
        "src/components/*/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "bin/**",
        "packages/**",
        "scripts/**",
        "test/**/fixture-app/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
